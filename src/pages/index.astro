---
import "@fontsource-variable/inter/wght.css";
import { getImage } from 'astro:assets';
import PeriodPicker from '../components/PeriodPicker.astro';
import leagueCrest from '../assets/league-crest.png';
import {categories,normalize,rosterBase} from '../lib/fantrax';
import {seasonStandings,standings} from '../lib/rankings';
import shootingVerification from '../../data/2026-27/shooting-verification.json';
const crest = await getImage({ src: leagueCrest, width: 256, format: 'webp', quality: 90 });
const raw=import.meta.glob('../../data/2026-27/raw/week-*.json',{eager:true,query:'?raw',import:'default'});
const weeks=Object.entries(raw).map(([path,s])=>normalize(s as string,Number(path.match(/week-(\d+)/)![1]))).sort((a,b)=>a.period-b.period);
const periods=weeks.map(w=>w.period);
const season=seasonStandings(weeks,shootingVerification.resolvedWeeks);
const data=[season.rows,...weeks.map(w=>standings([w]))];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Transatlantic Ballers · League rankings</title><link rel="stylesheet" href="/league.css"/></head>
<body id="top">
<nav aria-label="Rankings"><div class="nav-inner">
  <a class="season-link" href="#top">2026-27 Season</a>
  <a href="#power" aria-current="location">Power</a><a href="#spread">Spread</a><a href="#motion">Weekly</a>
</div></nav>
<main>
<h1 class="league-title">
  <img class="league-crest" src={crest.src} width="76" height="76" alt="" />
  <span>Transatlantic Ballers</span>
</h1>
<section id="power"><h2>Power rankings</h2><div class="controls"><PeriodPicker id="period" periods={periods} label="Scoring period" /><div><button id="rank" aria-pressed="true">Ranks</button><button id="production" aria-pressed="false">Per game</button></div></div>
<p id="note" hidden>{season.note}</p>
<div class="scroll"><table><thead><tr><th><button data-sort="-1">Rank</button></th><th>Team</th><th>Roto</th><th>GP</th>{categories.map((c,i)=><th><button data-sort={i}>{c}</button></th>)}</tr></thead><tbody></tbody></table></div>
<div class="key">Category rank {['1–3','4–6','7–9','10–12'].map((v,i)=><span><b class={'tier'+i}></b>{v}</span>)}</div></section>
<section id="spread" aria-labelledby="spread-heading">
  <h2 id="spread-heading">Category spread</h2>
  <div class="spread-controls">
    <PeriodPicker id="spread-period" periods={periods} label="Category spread period" />
    <div class="spread-key"><span><i class="band-key"></i>Middle 50%</span><span><i class="median-key"></i>Median</span></div>
  </div>
  <p>Each dot is a team. Counting stats are per player-game. Hover or tap a dot to trace a team across categories.</p>
  <p id="spread-note" hidden>{season.note}</p>
  <div class="spread-head" aria-hidden="true"><span>Category</span><span>Low to high</span><span>Median</span></div>
  <div id="distributions">
    {categories.map(category => <div class="spread-row" role="group" aria-label={category}>
      <strong class="spread-category">{category}</strong>
      <div class="spread-plot">
        <div class="spread-track"><div class="spread-axis"></div><div class="spread-band"></div><div class="spread-median"></div></div>
        <div class="spread-range"><span></span><span></span></div>
      </div>
      <span class="spread-middle"></span>
    </div>)}
  </div>
  <div id="spread-tip" class="chart-tip" role="tooltip" hidden></div>
</section>
<section id="motion">
  <h2>Weekly rankings</h2>
  <p>Hover over a dot for its numbers. Click or tap a line or team name to pin or unpin it.</p>
  <div class="chart-controls">
    <div id="pills" class="segments" role="group" aria-label="Chart category">
      {['Overall',...categories].map((c,i)=><button data-metric={i-1} aria-pressed={i===0}>{c}</button>)}
    </div>
    <div class="segments" role="group" aria-label="Chart scale">
      <button data-scale="rank" aria-pressed="true">Rank</button>
      <button data-scale="value" aria-pressed="false">Value</button>
    </div>
  </div>
  <div class="scroll"><svg id="chart" viewBox="0 0 1000 384" role="group" aria-label="Weekly team rankings"></svg></div>
  <div id="point-tip" class="chart-tip" role="tooltip" hidden></div>
</section>
<footer><p><strong>How rankings work.</strong> Counting stats are divided by player-games. Season FG% and FT% use total makes divided by total attempts, including the current week. Weekly shooting uses Fantrax percentages at full available precision. Ties share the average of the ranks they occupy. Each category earns 13 minus its rank in roto points, for a maximum of 96.</p></footer></main>
<script type="application/json" id="data" data-weeks={JSON.stringify(periods)} data-roster-base={rosterBase} set:html={JSON.stringify(data).replaceAll('<','\\u003c')}></script>
<script>
  import '../scripts/league';
  import '../scripts/weekly-chart';
</script>
</body></html>
