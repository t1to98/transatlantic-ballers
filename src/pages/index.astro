---
import {categories,normalize} from '../lib/fantrax';
import {standings} from '../lib/rankings';
const raw=import.meta.glob('../../data/2026-27/raw/week-*.json',{eager:true,query:'?raw',import:'default'});
const weeks=Object.entries(raw).map(([path,s])=>normalize(s as string,Number(path.match(/week-(\d+)/)![1]))).sort((a,b)=>a.period-b.period);
const latest=weeks.at(-1)!.period;
const data=[standings(weeks),...weeks.map(w=>standings([w]))];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Transatlantic Ballers · League rankings</title><link rel="stylesheet" href="/league.css"/></head>
<body><main><header><span>League analytics</span><span>2026–27 season</span></header>
<h1>Transatlantic <i>Ballers</i></h1>
<nav><a href="#power">Power rankings</a><a href="#motion">Season in motion</a><a href="https://www.fantrax.com/fantasy/league/jdc94v3kmtvppxcs">Fantrax ↗</a></nav>
<section id="power"><h2>Power rankings</h2><div class="controls"><select id="period" aria-label="Scoring period"><option value="0">Season to date</option>{[...weeks].reverse().map(w=><option value={w.period}>Week {w.period} · {w.period===latest?'In progress':'Final'}</option>)}</select><div><button id="rank" aria-pressed="true">Ranks</button><button id="production" aria-pressed="false">Per game</button></div></div>
<p id="note">Season shooting totals are awaiting verification. Overall ranks and roto scores are available for individual weeks.</p>
<div class="scroll"><table><thead><tr><th><button data-sort="-1">Rank / Team</button></th><th>Roto</th><th>GP</th>{categories.map((c,i)=><th><button data-sort={i}>{c}</button></th>)}</tr></thead><tbody></tbody></table></div>
<div class="key">Category rank {['1–3','4–6','7–9','10–12'].map((v,i)=><span><b class={'tier'+i}></b>{v}</span>)}</div></section>
<section id="motion"><h2>Season in motion</h2><p>Weekly league ranks. Select a team to follow its season.</p><div id="pills">{['Overall',...categories].map((c,i)=><button data-metric={i-1} aria-pressed={i===0}>{c}</button>)}</div><div class="scroll"><svg id="chart" viewBox="0 0 1000 375" aria-label="Weekly team rankings"></svg></div></section>
<footer><h3>How rankings work</h3><p>Counting stats are divided by player-games. Season rates use total production divided by total games. Weekly shooting uses Fantrax percentages at full available precision. Ties share the average of the ranks they occupy. Each category earns 13 minus its rank in roto points, for a maximum of 96.</p></footer></main>
<script type="application/json" id="data" set:html={JSON.stringify(data).replaceAll('<','\\u003c')}></script><script src="/league.js" is:inline type="module"></script></body></html>
